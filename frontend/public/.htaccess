# Plesk sirve frontend/dist. /api va a la aplicación PHP, que está fuera de la raíz web.
RewriteEngine On
SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
RewriteRule ^api(?:/|$) backend.php [END]

# El resto de rutas desconocidas cargan la aplicación React.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [END]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
  <FilesMatch "\.(woff2|png|svg|js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
