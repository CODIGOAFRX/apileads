{
  "name": "estaciondiseno/apileads",
  "description": "API PHP de gestión de leads para el equipo comercial de Estación Diseño.",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "firebase/php-jwt": "^7.0",
    "phpoffice/phpspreadsheet": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0"
  },
  "autoload": {
    "psr-4": { "Leads\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Leads\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "migrate": "php bin/migrate.php"
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    }
  }
}
