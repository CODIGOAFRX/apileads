# ─── Aplicación ────────────────────────────────────────────────────────────────
APP_TIMEZONE=Europe/Madrid
APP_DEBUG=0

# ─── Base de datos (MariaDB) ───────────────────────────────────────────────────
# En Plesk: Bases de datos → la de leads. El host suele ser localhost.
DB_DSN=mysql:host=localhost;port=3306;dbname=apileads;charset=utf8mb4
DB_USER=apileads
DB_PASSWORD=cambia-esta-contraseña

# ─── Sesión ────────────────────────────────────────────────────────────────────
# Genera uno con:  php -r "echo base64_encode(random_bytes(48)), PHP_EOL;"
JWT_SECRET=pon-aqui-un-secreto-largo-y-aleatorio
# Duración de la sesión en segundos (12 h)
JWT_TTL_SECONDS=43200

# Primer administrador: se crea al ejecutar bin/migrate.php si no hay usuarios.
ADMIN_EMAIL=admin@estaciondiseno.es
ADMIN_PASSWORD=cambia-esta-contraseña-de-admin

# Solo si el frontend se sirve desde otro dominio (en Plesk no hace falta).
CORS_ALLOWED_ORIGINS=

# ─── Flujo comercial ───────────────────────────────────────────────────────────
# Hora a la que vuelven a "pendientes" los que no contestaron (siguiente día laborable).
HORA_REAPERTURA=09:00
# Festivos (no se vuelve a llamar esos días), separados por comas: 2026-12-08,2026-12-25
FESTIVOS=
# Al llegar a este número de intentos sin respuesta el lead se descarta solo (0 = nunca)
MAX_INTENTOS_SIN_RESPUESTA=6
# Minutos que un lead queda reservado para la comercial que lo está llamando
MINUTOS_BLOQUEO_LLAMADA=5
# Mensaje de WhatsApp. Variables: {nombre} {comercial} {estudio}
WHATSAPP_MENSAJE="Hola {nombre}, soy {comercial} de Estación Diseño. Te he intentado llamar por tu interés en {estudio}. ¿Cuándo te viene bien que hablemos?"

# ─── Importación ───────────────────────────────────────────────────────────────
IMPORT_MAX_MB=10

# ─── Correo ────────────────────────────────────────────────────────────────────
# smtp = buzón del servidor (recomendado) · mail = función mail() de PHP · log = no envía, escribe en storage/logs/correos.log
MAIL_TRANSPORT=smtp
MAIL_HOST=mail.estaciondiseno.es
MAIL_PORT=587
# tls (puerto 587) · ssl (puerto 465) · none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=admisiones@estaciondiseno.es
MAIL_PASSWORD=contraseña-del-buzon
MAIL_FROM=admisiones@estaciondiseno.es
MAIL_FROM_NAME="Estación Diseño"
# Si se deja vacío, las respuestas van al correo de la comercial que envía.
MAIL_REPLY_TO=
# Las comerciales con buzón propio (Ajustes → Usuarios → correo) envían desde él; este es el remitente de las demás.
# Clave para cifrar las contraseñas de esos buzones. Vacía = se usa JWT_SECRET. Si cambia, hay que volver a escribirlas.
MAIL_ACCOUNTS_KEY=
# Como mucho un correo cada tantos segundos en toda la aplicación (72 s = 50 por hora, el límite del servidor).
MAIL_SEGUNDOS_ENTRE_ENVIOS=72
